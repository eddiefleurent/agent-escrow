# Test environment -- Base Sepolia (chain ID 84532)
# Copy to .env.test and fill in values. Never commit .env.test.

# Required
RPC_URL=https://sepolia.base.org
PRIVATE_KEY=0xYOUR_TEST_PRIVATE_KEY
FACTORY_ADDRESS=0x_deployed_factory_address_on_sepolia

# Chain (defaults are already Base Sepolia, listed here for clarity)
CHAIN_ID=84532

# Server (DATABASE_URL is overridden by compose to /data/delegation.db)
PORT=8080

# Complexity floor: 0.001 ETH on testnet (loose -- faucet funds are plentiful)
# COMPLEXITY_FLOOR=1000000000000000

# CDP Webhooks (optional -- polling indexer covers everything, webhooks add real-time factory events)
# CDP_WEBHOOK_SECRET=whsec_your_webhook_secret

# x402 / AP2 (optional)
# X402_ENABLED=false
# X402_FACILITATOR_URL=https://api.developer.coinbase.com/v2/x402

# A2A adapter (enabled by default)
# A2A_ENABLED=true
# A2A_AGENT_NAME=Escrow Settlement Agent (Test)
# A2A_AGENT_URL=https://your-tailscale-hostname/

# Events (enabled by default)
# EVENTS_ENABLED=true
# EVENTS_HEARTBEAT_INTERVAL=30s
