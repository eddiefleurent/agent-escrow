# Required for chain operations (Go server)
RPC_URL=https://sepolia.base.org
PRIVATE_KEY=0x_your_private_key_here
FACTORY_ADDRESS=0x_deployed_factory_address

# Optional (defaults shown)
CHAIN_ID=84532
PORT=8080
DATABASE_URL=delegation.db
# MCP_TRANSPORT=stdio
# START_BLOCK=0

# Deployment
# DEPLOYER_ADDRESS=0x_your_deployer_address
# TREASURY=0x_treasury_address
# OWNER=0x_owner_address
# PROTOCOL_FEE_BPS=100
# BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Complexity floor: minimum escrow amount (in wei or smallest token unit)
# to justify delegation overhead. 0 or unset = disabled (no minimum).
# Example: 10000000000000000 = 0.01 ETH
# COMPLEXITY_FLOOR=10000000000000000

# CDP Webhooks: set to receive real-time factory events (EscrowCreated,
# OutcomeRecorded) via push instead of polling. The polling indexer still
# runs for escrow-level events. The secret is returned when you create a
# webhook subscription in the CDP portal or via the CDP REST API.
# See: https://docs.cdp.coinbase.com/data/webhooks/overview
# CDP_WEBHOOK_SECRET=whsec_your_webhook_secret

# x402 / AP2 mandate-to-escrow bridge (paper §6)
# Enable gasless EIP-3009 funding via x402 facilitator
# X402_ENABLED=false
# X402_FACILITATOR_URL=https://api.developer.coinbase.com/v2/x402

# CDP faucet (scripts/faucet.py)
# Get credentials at https://portal.cdp.coinbase.com
# CDP_API_KEY_ID=your-api-key-id
# CDP_API_KEY_SECRET=your-api-key-secret
# CDP_WALLET_SECRET=your-wallet-secret
