@startuml state-machine
skinparam backgroundColor #FFFFFF
skinparam defaultFontName "Helvetica"
skinparam defaultFontSize 13
skinparam shadowing false
skinparam ArrowColor #555555
skinparam ArrowFontSize 11
skinparam ArrowFontColor #666666

skinparam state {
  FontSize 14
  FontStyle bold
  AttributeFontSize 11
}

skinparam note {
  BackgroundColor #FFFDE7
  BorderColor #E0D68A
  FontSize 11
}

title Escrow State Machine

state Created #E3F2FD ##42A5F5
state Funded #E3F2FD ##42A5F5
state Submitted #E3F2FD ##42A5F5
state Approved #E8F5E9 ##66BB6A
state Disputed #FFF3E0 ##FFA726
state Resolved #FFF3E0 ##FFA726

state Settled #C8E6C9 ##388E3C
state Refunded #FFE0B2 ##F57C00
state Cancelled #E0E0E0 ##9E9E9E

[*] --> Created

Created --> Funded : fund() / fundWithAuthorization()
Created --> Cancelled : cancel()

Funded --> Funded : depositStake()
Funded --> Funded : activateBackup()
Funded --> Submitted : submit(submissionHash, submissionURI, proofHash)
Funded --> Refunded : timeout refund

Submitted --> Approved : buyer or verifier approves\n(tier 0: either; tier 1: verifier only)
Submitted --> Approved : verifier verifyAndApprove(proof)\n(when zkVerifier configured)
Submitted --> Disputed : buyer disputes
Submitted -[#FF8F00]-> Disputed : verifier rejects
Submitted -[#FF8F00]-> Disputed : worker escalates silence
Submitted -[#FF8F00]-> Disputed : no-quorum expiry\n(expireNoQuorum)

Disputed --> Resolved : arbitrator resolves
Disputed --> Refunded : arbitrator timeout

Approved -[#388E3C]-> Settled : auto-settle
Resolved -[#388E3C]-> Settled : auto-settle

Cancelled --> [*]
Refunded --> [*]
Settled --> [*]

' Emergency response protocol (paper §4.9)
Created -[#D32F2F,dashed]-> Resolved : emergencyResolve()
Funded -[#D32F2F,dashed]-> Resolved : emergencyResolve()
Submitted -[#D32F2F,dashed]-> Resolved : emergencyResolve()
Disputed -[#D32F2F,dashed]-> Resolved : emergencyResolve()

note right of Funded
  Worker must depositStake()
  before submit() when
  workerStake > 0.
  Buyer may activateBackup()
  to swap in the backup worker.
end note

note right of Submitted
  Review window opens.
  Four paths to Disputed:
  buyer, verifier, worker,
  or no-quorum expiry.
  **Tier 1 (high-assurance)**:
  buyer approval blocked;
  verifier must approve
  (optionally via verifyAndApprove()).
end note

note right of Resolved
  Arbitrator sets split (0-100%).
  Stake follows same split ratio.
  0% = full refund + stake to buyer.
  100% = full payout + stake returned.
end note

note bottom of Resolved
  **Emergency path** (dashed red):
  Owner freezes escrow, then calls
  emergencyResolve(bps). Same
  settlement math as dispute resolution.
end note

@enduml

@startuml milestone-state-machine
skinparam backgroundColor #FFFFFF
skinparam defaultFontName "Helvetica"
skinparam defaultFontSize 13
skinparam shadowing false
skinparam ArrowColor #555555
skinparam ArrowFontSize 11
skinparam ArrowFontColor #666666

skinparam state {
  FontSize 14
  FontStyle bold
  AttributeFontSize 11
}

skinparam note {
  BackgroundColor #FFFDE7
  BorderColor #E0D68A
  FontSize 11
}

title Milestone State Machine (Multi-Milestone Escrow)

state "Escrow: Funded" as EscrowFunded #E3F2FD ##42A5F5 {

  state "Milestone[i]" as ms {
    state Pending #E3F2FD ##42A5F5
    state MsSubmitted as "Submitted" #E3F2FD ##42A5F5
    state MsApproved as "Approved" #E8F5E9 ##66BB6A
    state MsDisputed as "Disputed" #FFF3E0 ##FFA726
    state MsResolved as "Resolved" #FFF3E0 ##FFA726
    state MsCancelled as "Cancelled" #E0E0E0 ##9E9E9E

    [*] --> Pending

    Pending --> MsSubmitted : submitMilestone(i, hash, URI, proofHash)
    Pending --> MsCancelled : timeout / abort

    MsSubmitted --> MsApproved : buyer/verifier approves\n(tier 0: either; tier 1: verifier only)
    MsSubmitted --> MsApproved : verifier verifyAndApproveMilestone(i, proof)\n(when zkVerifier configured)
    MsSubmitted --> MsDisputed : buyer disputes
    MsSubmitted --> MsDisputed : verifier rejects
    MsSubmitted --> MsDisputed : worker escalates
    MsSubmitted --> MsDisputed : no-quorum expiry\n(expireMilestoneNoQuorum)

    MsDisputed --> MsResolved : arbitrator resolves
    MsDisputed --> MsCancelled : arbitrator timeout

    MsApproved --> [*] : settle & advance
    MsResolved --> [*] : settle & advance
    MsCancelled --> [*] : refund & advance
  }
}

note right of EscrowFunded
  Escrow stays **Funded** throughout
  milestone processing. Terminal
  state reached when all milestones
  are in Approved/Resolved/Cancelled.
end note

note bottom of ms
  Sequential: milestoneIndex == currentMilestone.
  Max 16 milestones. Worker stake settled
  once at escrow terminal state.
  abortRemainingMilestones() cancels
  all pending milestones after a failure.
end note

@enduml
