@startuml bidding-sequence
skinparam backgroundColor #FFFFFF
skinparam defaultFontName "Helvetica"
skinparam defaultFontSize 12
skinparam shadowing false
skinparam sequenceArrowThickness 1.5
skinparam sequenceLifeLineBorderColor #CCCCCC
skinparam sequenceDividerBackgroundColor #F5F5F5
skinparam sequenceDividerFontStyle bold
skinparam sequenceGroupBackgroundColor #FAFAFA
skinparam sequenceGroupBorderColor #CCCCCC

skinparam participant {
  BorderColor #42A5F5
  BackgroundColor #E3F2FD
  FontStyle bold
}

skinparam actor {
  BorderColor #7E57C2
  BackgroundColor #EDE7F6
}

skinparam note {
  BackgroundColor #FFFDE7
  BorderColor #E0D68A
  FontSize 11
}

title Task_RFQ + Bid_Object Bidding Protocol\n(+ Contract-First Decomposition Planning, Paper §4.1 / §6.1)

actor "Buyer Agent" as Buyer
participant "Go Server\n(MCP / HTTP)" as Server
database "SQLite" as DB
actor "Worker Agent A" as WorkerA
actor "Worker Agent B" as WorkerB
participant "Base L2\n(Contracts)" as Chain

== Optional Pre-RFQ Decomposition (V3) ==

Buyer -> Server : create_decomposition / POST /api/v1/decompositions\n(sub_tasks_json with verification_type per leaf)
Server -> DB : INSERT decomposition + decomposition_nodes
Server -> Server : Structural validation (leaf verifiability)\n+ market context queries (depth/verifier_count/signal)
Server --> Buyer : status=draft|valid,\nissues[], market_context[]

alt Draft (structural blockers found)
  Buyer -> Server : create_decomposition (revised)
  Server -> DB : insert revised decomposition + nodes
  Server --> Buyer : status=valid
else Valid
  Buyer -> Server : finalize_decomposition / POST /api/v1/decompositions/{id}/finalize
  Server -> DB : For each leaf: create RFQ with mapped\nservice_tier + bidding_mode
  Server -> DB : UPDATE decomposition status=finalized, rfq_ids_json
  Server --> Buyer : rfq_ids[]
end

== RFQ Broadcast (direct path or decomposition-generated RFQs) ==

Buyer -> Server : create_rfq / POST /api/v1/rfqs\n(title, budget_min/max, deadline, commit_deadline, reveal_deadline,\noptional required_credentials_json)
Server -> DB : If parent_escrow_id set:\nvalidate buyer == parent active_worker
Server -> DB : Fetch latest parent-linked RFQ activity
Server -> Server : Enforce re-bid cooldown window\n(reject with retry timing when active)
Server -> DB : INSERT rfq (status=open, bidding_mode=sealed)
Server --> Buyer : rfq_id, status=open

note over Server : Workers discover RFQs via list_rfqs / GET /api/v1/rfqs?status=open\nCredential schemas via Bazaar discovery: GET /api/v1/bazaar/discovery

== Commit Phase (sealed bids) ==

WorkerA -> Server : commit_bid / POST /api/v1/rfqs/{id}/bids/commit\n(commitment=0x..., nonce)
Server -> DB : Validate: bidder != buyer, RFQ open, before commit_deadline
Server -> DB : Check sealed-bid cooldown for bidder
Server -> DB : INSERT bid_commit (status=committed)
Server --> WorkerA : commit_id, status=committed

WorkerB -> Server : commit_bid / POST /api/v1/rfqs/{id}/bids/commit\n(commitment=0x..., nonce)
Server -> DB : Supersede any prior unrevealed commit\nfor same bidder+RFQ, then INSERT bid_commit
Server --> WorkerB : commit_id, status=committed

note over Server : Commitment = keccak256(amount|duration|salt|nonce|...)\nAmount/price hidden until reveal (sealed mode)

== Reveal Phase ==

WorkerA -> Server : reveal_bid / POST /api/v1/rfqs/{id}/bids/reveal\n(amount=200, duration=3600, salt, nonce,\ncredentials_json=[attestation-v1 payloads])
Server -> Server : Verify commitment matches stored hash
Server -> Server : Validate attestations: signature, subject=bidder, expiry
Server -> Server : Match credentials against RFQ required_credentials_json
Server -> DB : INSERT bid (status=pending, credential_verified=true/false)
Server -> DB : UPDATE bid_commit: status=revealed, bid_id=N
Server --> WorkerA : bid_id, status=pending, credential_verified

WorkerB -> Server : reveal_bid / POST /api/v1/rfqs/{id}/bids/reveal\n(amount=300, duration=7200, salt, nonce,\ncredentials_json=[...])
Server -> Server : Verify + credential match
Server -> DB : INSERT bid (status=pending)
Server --> WorkerB : bid_id, status=pending

== Bid Evaluation ==

Buyer -> Server : list_bids / GET /api/v1/rfqs/{id}/bids
Server -> DB : After reveal_deadline: expire unrevealed commits,\napply bidder cooldowns, rank revealed eligible bids\nby amount -> duration -> commit time -> bid id
Server -> DB : SELECT bids WHERE rfq_id=?
Server --> Buyer : [bid_A(200, credential_verified=true), bid_B(300, credential_verified=false)]

note over Buyer : Evaluate bids:\ncost, reputation, capability, credential_verified\n(Paper §4.3: multi-objective optimization)\nAll bids carry credential_verified (false when no credentials or match failed)

== Bid Acceptance → Escrow Formalization ==

Buyer -> Server : accept_bid / POST /api/v1/rfqs/{id}/accept\n(bid_id=bid_A)

group Atomic acceptance
  Server -> DB : Re-run sealed-bid finalization if needed;\nreject bids outside finalized eligible set
  Server -> Server : If required_credentials present:\nreject unless bid.credential_verified
  Server -> Chain : createEscrow(buyer, worker_A,\namount=200, verifier, arbitrator, deadline,\noptional parentEscrow)
  Chain -> Chain : Snapshot fee = base tier fee +\nparent-linked re-delegation surcharge (if any)
  Chain --> Server : tx_hash, escrow_address, escrow_id

  Server -> DB : INSERT task + escrow (status=created)
  Server -> DB : UPDATE bid_A: status=accepted, escrow_id=N
  Server -> DB : UPDATE rfq: status=closed
  Server -> DB : UPDATE bid_B: status=rejected
end

Server --> Buyer : escrow_id, escrow_address, tx_hash

note over WorkerB : Bid rejected;\nfree to bid on other RFQs

== Post-Acceptance: Standard Escrow Lifecycle ==

note over Buyer, Chain : Buyer funds escrow (fund or fund_via_mandate) → Worker submits → Verifier approves → Settlement\n(See lifecycle-sequence diagram)

== Reputation Update + Damping ==

Chain -> Server : OutcomeRecorded(participant, role, outcome)
Server -> DB : Upsert raw counters in reputation
Server -> DB : Append immutable reputation_events\n(unique by tx_hash + log_index + address + role)
Server -> Server : Compute damped metrics\n(configurable decay factor)
Buyer -> Server : get_reputation / GET /api/v1/reputation/{address}
Server --> Buyer : raw counters + damped metrics

@enduml
