@startuml architecture
skinparam backgroundColor #FFFFFF
skinparam componentStyle rectangle
skinparam defaultFontName "Helvetica"
skinparam defaultFontSize 13
skinparam shadowing false
skinparam roundCorner 8
skinparam ArrowColor #555555
skinparam ArrowFontSize 11

skinparam package {
  BorderColor #BBBBBB
  FontStyle bold
}

skinparam note {
  BackgroundColor #FFFDE7
  BorderColor #E0D68A
  FontSize 11
}

title System Architecture

package "AI Agents" as agents #E8EAF6 {
  [Shell Agent\n(Codex, Cursor, etc.)] as shell_agent #C5CAE9
  [Skill File\n(skills/escrow-cli/SKILL.md)] as skill_file #C5CAE9
  [escrow-cli\n(thin HTTP client)] as cli_client #C5CAE9
  [MCP Client\n(Claude, GPT, etc.)] as mcp_client #C5CAE9
  [HTTP Client\n(Scripts, Agents)] as http_client #C5CAE9
  [UCP Client\n(Integrators)] as ucp_client #C5CAE9
  [SSE/WS Client\n(Event Subscribers)] as stream_client #C5CAE9
}

package "Go Server" as server #E3F2FD {
  package "Agent Interfaces" as ifaces #BBDEFB {
    [MCP Server\n(+ decomposition tools)] as mcp_server #BBDEFB
    [HTTP / AP2 / UCP API\n(+ decomposition routes)] as http_api #BBDEFB
    [SSE / WebSocket] as stream_handler #BBDEFB
  }

  package "Event Pipeline" as pipeline #BBDEFB {
    [Indexer + Webhooks\n(on-chain -> off-chain)] as indexer #BBDEFB
    [Event Bus\n(pub/sub)] as event_bus #BBDEFB
  }

  package "Data Layer" as data #E1F5FE {
    [Chain Client\n(go-ethereum)] as chain_client #B3E5FC
    [Storage\n(SQLite)] as storage #B3E5FC
  }

  ifaces -down-> data
  pipeline -down-> data
  event_bus -right-> stream_handler
}

package "Third-Party Services" as external #FFF3E0 {
  [x402 Facilitator\n(payment verification)] as x402 #FFE0B2
  [Coinbase Webhooks\n(on-chain event push)] as cdp #FFE0B2
}

package "Base (Ethereum L2)" as chain #E8F5E9 {
  [TaskEscrowFactory\n+ reputation] as factory #A5D6A7
  [TaskEscrow\ninstances] as escrow #A5D6A7
  factory -right-> escrow : deploys
}

' --- Agent-to-server ---
shell_agent -down-> skill_file : reads
shell_agent -down-> cli_client : runs
cli_client -down-> http_api : JSON
mcp_client -down-> mcp_server : stdio / HTTP
http_client -down-> http_api : JSON
ucp_client -down-> http_api : UCP REST
stream_client -down-> stream_handler : SSE / WebSocket

' --- Server-to-chain ---
chain_client -down-> chain : JSON-RPC

' --- External integrations ---
http_api -right-> x402
cdp -left-> chain : watches
cdp -up-> indexer : push events

note bottom of storage
  Off-chain index; chain
  is source of truth.
end note

@enduml

