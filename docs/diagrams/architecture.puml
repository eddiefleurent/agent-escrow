title Go Server — Internal Detail

package "Go Server" as server #E3F2FD {
  package "Agent Interfaces" as ifaces #BBDEFB {
    [HTTP API\n(JSON REST + decomposition)] as http_api #BBDEFB
    [MCP Server\n(stdio / streamable-HTTP + decomposition)] as mcp_server #BBDEFB
    [CLI via HTTP\n(escrow-cli)] as cli_iface #BBDEFB
    [UCP Handler\n(/.well-known/ucp + /api/v1/ucp/*)] as ucp_handler #BBDEFB
    [AP2 Handler\n(/api/v1/ap2/*)] as ap2 #BBDEFB
    [SSE/WS Handlers\n(stream.go)] as stream_handler #BBDEFB
  }

  package "Domain Services" as services #BBDEFB {
    [Escrow Service\n(shared lifecycle orchestration)] as escrow_service #BBDEFB
    [UCP Service\n(checkout projection + idempotency)] as ucp_service #BBDEFB
    [Bidding Service\n(RFQ + Bid lifecycle)] as bidding_service #BBDEFB
    [Decomposition Service\n(structural validation + RFQ planning)] as decomposition_service #BBDEFB
  }

  package "Event Pipeline" as pipeline #BBDEFB {
    [Event Indexer\n(background poller)] as indexer #BBDEFB
    [Webhook Handler\n(/webhooks/cdp)] as webhook #BBDEFB
    [Event Bus\n(in-process pub/sub)] as event_bus #BBDEFB
  }

  package "Authorization" as authz_pkg #E8EAF6 {
    [Authz Engine\n(default-deny policy)] as authz_engine #C5CAE9
    [Audit Store\n(decision logging)] as audit_store #C5CAE9
  }

  package "Data Layer" as data #E1F5FE {
    [Chain Client\n(go-ethereum)] as chain_client #B3E5FC
    [Storage\n(SQLite)] as storage #B3E5FC
  }

  cli_iface -down-> http_api
  ucp_handler -down-> ucp_service
  ucp_service -down-> escrow_service
  ucp_service -down-> storage
  mcp_server -down-> bidding_service
  mcp_server -down-> decomposition_service
  mcp_server -down-> escrow_service
  mcp_server -down-> chain_client
  mcp_server -down-> storage
  mcp_server -right-> event_bus : subscribe_events\n(polling)
  mcp_server -down-> authz_engine : DCT authz
  http_api -down-> bidding_service
  http_api -down-> decomposition_service
  http_api -down-> escrow_service
  http_api -down-> chain_client
  http_api -down-> storage
  http_api -down-> authz_engine : DCT authz
  ap2 -down-> chain_client
  ap2 -down-> storage
  escrow_service -down-> chain_client
  escrow_service -down-> storage
  bidding_service -down-> chain_client
  bidding_service -down-> storage
  decomposition_service -right-> bidding_service : finalize -> create RFQs
  decomposition_service -down-> storage
  authz_engine -down-> storage : role lookup
  authz_engine -right-> audit_store : emit decisions
  audit_store -down-> storage : audit log
  webhook -down-> storage
  webhook -right-> event_bus : publish
  indexer -down-> chain_client
  indexer -down-> storage
  indexer -right-> event_bus : publish
  event_bus -right-> stream_handler : filtered\nevents
}

package "Third-Party Services" as external #FFF3E0 {
  [x402 Facilitator\n(payment verification)] as x402 #FFE0B2
  [Coinbase Webhooks\n(on-chain event push)] as cdp #FFE0B2
}

package "Base (Ethereum L2)" as chain_pkg #E8F5E9 {
  [TaskEscrowFactory\n+ reputation storage] as factory #A5D6A7
  [TaskEscrow\ninstances] as escrow #A5D6A7
  factory -right-> escrow : deploys
  escrow -left-> factory : recordOutcome()

  note right of escrow
    Each TaskEscrow calls recordOutcome()
    on the factory at settlement to report
    task results for on-chain reputation
    tracking and scoring.
  end note
}

ap2 -down-> x402 : verify + settle
chain_client -down-> factory : JSON-RPC
chain_client -down-> escrow : JSON-RPC
indexer ..down..> factory : poll events
indexer ..down..> escrow : poll events
cdp -left-> chain_pkg : watches
cdp -up-> webhook : push events

note bottom of storage
  Off-chain index; chain
  is source of truth.
end note

note left of event_bus
  Pub/sub for real-time
  state transitions (§4.5)
end note

@enduml

