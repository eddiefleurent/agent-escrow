@startuml lifecycle-sequence
skinparam backgroundColor #FFFFFF
skinparam defaultFontName "Helvetica"
skinparam defaultFontSize 12
skinparam shadowing false
skinparam sequenceArrowThickness 1.5
skinparam sequenceLifeLineBorderColor #CCCCCC
skinparam sequenceDividerBackgroundColor #F5F5F5
skinparam sequenceDividerFontStyle bold
skinparam sequenceGroupBackgroundColor #FAFAFA
skinparam sequenceGroupBorderColor #CCCCCC

skinparam participant {
  BorderColor #42A5F5
  BackgroundColor #E3F2FD
  FontStyle bold
}

skinparam actor {
  BorderColor #7E57C2
  BackgroundColor #EDE7F6
}

skinparam note {
  BackgroundColor #FFFDE7
  BorderColor #E0D68A
  FontSize 11
}

title Escrow Lifecycle

actor "Buyer" as buyer
actor "Worker" as worker
participant "Factory" as factory

== Task Creation ==

buyer -> factory : create escrow
factory -> "Escrow" as escrow ** : deploy
factory --> buyer : escrow id + address

== Funding ==

buyer -> escrow : fund
note over escrow #E3F2FD : **Funded** — ETH/ERC20 held

== Worker Stake (optional) ==

opt workerStake > 0
  worker -> escrow : depositStake
  note over escrow #FFFDE7 : Anti-Sybil bond held
end

== Work Submission ==

worker -> escrow : submit (hash + URI)
note over escrow #E3F2FD : **Submitted** — review window opens

== Path A: Approval ==

alt #E8F5E9 Buyer approves
  buyer -> escrow : approve
else #E8F5E9 Verifier approves
  "Verifier" as verifier -> escrow : approve
end

escrow -[#388E3C]> worker : payout (amount - fee) + stake returned
escrow -[#388E3C]> "Treasury" as treasury ** #E8F5E9 : protocol fee
note over escrow #C8E6C9 : **Settled**

== Path B: Dispute Resolution ==

alt #FFF3E0 Buyer disputes
  buyer -> escrow : dispute
else #FFF3E0 Verifier rejects
  verifier -> escrow : reject
else #FFF3E0 Worker escalates silence
  worker -> escrow : escalate
end

note over escrow #FFF3E0 : **Disputed**

"Arbitrator" as arbitrator -> escrow : resolve (split %)

escrow -[#F57C00]> worker : worker share + proportional stake
escrow -[#F57C00]> buyer : buyer refund + forfeited stake
escrow -[#F57C00]> treasury : protocol fee
note over escrow #C8E6C9 : **Settled**

@enduml

@startuml milestone-lifecycle-sequence
skinparam backgroundColor #FFFFFF
skinparam defaultFontName "Helvetica"
skinparam defaultFontSize 12
skinparam shadowing false
skinparam sequenceArrowThickness 1.5
skinparam sequenceLifeLineBorderColor #CCCCCC
skinparam sequenceDividerBackgroundColor #F5F5F5
skinparam sequenceDividerFontStyle bold
skinparam sequenceGroupBackgroundColor #FAFAFA
skinparam sequenceGroupBorderColor #CCCCCC

skinparam participant {
  BorderColor #42A5F5
  BackgroundColor #E3F2FD
  FontStyle bold
}

skinparam actor {
  BorderColor #7E57C2
  BackgroundColor #EDE7F6
}

skinparam note {
  BackgroundColor #FFFDE7
  BorderColor #E0D68A
  FontSize 11
}

title Multi-Milestone Escrow Lifecycle

actor "Buyer" as buyer
actor "Worker" as worker
participant "Factory" as factory

== Creation (with milestones) ==

buyer -> factory : createEscrow(milestones[])
factory -> "Escrow" as escrow ** : deploy with N milestones
factory --> buyer : escrow id + address

== Funding ==

buyer -> escrow : fund (total amount)
note over escrow #E3F2FD : **Funded** — all milestone amounts held

== Worker Stake (optional) ==

opt workerStake > 0
  worker -> escrow : depositStake
end

== Milestone Loop ==

loop for each milestone i = 0..N-1

  == Milestone [i]: Submission ==

  worker -> escrow : submitMilestone(i, hash, URI)
  note over escrow #E3F2FD : Milestone[i] **Submitted**

  alt #E8F5E9 Milestone approved
    buyer -> escrow : approveMilestoneByBuyer(i)
    escrow -[#388E3C]> worker : milestone payout (amount - fee)
    escrow -[#388E3C]> "Treasury" as treasury ** #E8F5E9 : protocol fee
    note over escrow #C8E6C9 : Milestone[i] **Approved** — advance to i+1

  else #FFF3E0 Milestone disputed
    buyer -> escrow : disputeMilestone(i)
    "Arbitrator" as arbitrator -> escrow : resolveMilestoneDispute(i, split%)
    escrow -[#F57C00]> worker : worker share
    escrow -[#F57C00]> buyer : buyer refund
    note over escrow #FFF3E0 : Milestone[i] **Resolved** — advance to i+1

    opt Buyer aborts remaining
      buyer -> escrow : abortRemainingMilestones()
      escrow -[#9E9E9E]> buyer : remaining funds refunded
      note over escrow #E0E0E0 : Milestones[i+1..N-1] **Cancelled**
    end
  end

end

== Escrow Terminal ==

note over escrow #C8E6C9
  All milestones terminal.
  Worker stake settled based
  on overall outcome.
end note

@enduml

@startuml milestone-system-sequence
skinparam backgroundColor #FFFFFF
skinparam defaultFontName "Helvetica"
skinparam defaultFontSize 12
skinparam shadowing false
skinparam sequenceArrowThickness 1.5
skinparam sequenceLifeLineBorderColor #CCCCCC
skinparam sequenceDividerBackgroundColor #F5F5F5
skinparam sequenceDividerFontStyle bold
skinparam sequenceGroupBackgroundColor #FAFAFA
skinparam sequenceGroupBorderColor #CCCCCC

skinparam participant {
  BorderColor #42A5F5
  BackgroundColor #E3F2FD
  FontStyle bold
}

skinparam actor {
  BorderColor #7E57C2
  BackgroundColor #EDE7F6
}

skinparam note {
  BackgroundColor #FFFDE7
  BorderColor #E0D68A
  FontSize 11
}

title Multi-Milestone Escrow — System Sequence

actor "Buyer" as buyer
actor "Worker" as worker
participant "Chain Client" as chain
participant "Escrow" as escrow
participant "Indexer" as indexer
participant "DB" as db

== Creation ==

buyer -> chain : CreateEscrow(milestones[0..N-1])
chain -> escrow ** : deploy with N milestones
chain -> db : store escrow, MilestoneCount, MilestoneRecord[0..N-1]

== Funding ==

buyer -> chain : Fund
chain -> escrow : fund (total amount)
note over escrow #E3F2FD : **Funded** — all milestone amounts held

== Milestone Loop ==

loop for each milestone i = 0..N-1

  == Milestone [i]: Submission ==

  worker -> chain : SubmitMilestone(i, hash, URI)
  chain -> escrow : submitMilestone(i)
  note over escrow #E3F2FD : Milestone[i] **Submitted**
  escrow --> indexer : MilestoneSubmitted event
  indexer -> db : update milestone state

  alt #E8F5E9 Approval path
    buyer -> chain : ApproveMilestoneByBuyer(i)
    chain -> escrow : approveMilestoneByBuyer(i)
    escrow -[#388E3C]> worker : milestone payout (amount - fee)
    note over escrow #C8E6C9 : Milestone[i] **Approved**
    escrow --> indexer : MilestoneApproved event
    indexer -> db : update milestone state, record payout

  else #FFF3E0 Dispute path
    buyer -> chain : DisputeMilestone(i, reason)
    chain -> escrow : disputeMilestone(i)
    note over escrow #FFF3E0 : Milestone[i] **Disputed**
    escrow --> indexer : MilestoneDisputed event
    indexer -> db : update milestone state

    "Arbitrator" as arbitrator -> chain : ResolveMilestoneDispute(i, awardBps)
    chain -> escrow : resolveMilestoneDispute(i, awardBps)
    escrow -[#F57C00]> worker : worker share
    escrow -[#F57C00]> buyer : buyer refund
    note over escrow #FFF3E0 : Milestone[i] **Resolved**
    escrow --> indexer : MilestoneDisputeResolved event
    indexer -> db : update milestone state, record split

    opt Buyer aborts remaining
      buyer -> chain : AbortRemainingMilestones()
      chain -> escrow : abortRemainingMilestones()
      escrow -[#9E9E9E]> buyer : remaining funds refunded
      note over escrow #E0E0E0 : Milestones[i+1..N-1] **Cancelled**
      escrow --> indexer : RemainingMilestonesAborted event
      indexer -> db : mark remaining milestones cancelled
    end
  end

end

== Escrow Terminal ==

note over escrow #C8E6C9
  All milestones terminal.
  Worker stake settled based
  on overall outcome.
end note

@enduml
