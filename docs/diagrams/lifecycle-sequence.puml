title Multi-Milestone Escrow Lifecycle

actor "Buyer" as buyer
actor "Worker" as worker
participant "Factory" as factory

== Creation (with milestones) ==

buyer -> factory : createEscrow(milestones[])
factory -> "Escrow" as escrow ** : deploy with N milestones
factory --> buyer : escrow id + address

== Funding ==

buyer -> escrow : fund (total amount)
note over escrow #E3F2FD : **Funded** — all milestone amounts held

== Worker Stake (optional) ==

opt workerStake > 0
  worker -> escrow : depositStake
end

== Milestone Loop ==

loop for each milestone i = 0..N-1

  == Milestone [i]: Submission ==

  worker -> escrow : submitMilestone(i, hash, URI)
  note over escrow #E3F2FD : Milestone[i] **Submitted**

  alt #E8F5E9 Milestone approved
    buyer -> escrow : approveMilestoneByBuyer(i)
    escrow -[#388E3C]> worker : milestone payout (amount - fee)
    escrow -[#388E3C]> "Treasury" as treasury ** #E8F5E9 : protocol fee
    note over escrow #C8E6C9 : Milestone[i] **Approved** — advance to i+1

  else #FFF3E0 Milestone disputed
    buyer -> escrow : disputeMilestone(i)
    "Arbitrator" as arbitrator -> escrow : resolveMilestoneDispute(i, split%)
    escrow -[#F57C00]> worker : worker share
    escrow -[#F57C00]> buyer : buyer refund
    note over escrow #FFF3E0 : Milestone[i] **Resolved** — advance to i+1

    opt Buyer aborts remaining
      buyer -> escrow : abortRemainingMilestones()
      escrow -[#9E9E9E]> buyer : remaining funds refunded
      note over escrow #E0E0E0 : Milestones[i+1..N-1] **Cancelled**
    end
  end

end

== Escrow Terminal ==

note over escrow #C8E6C9
  All milestones terminal.
  Worker stake settled based
  on overall outcome.
end note

@enduml

